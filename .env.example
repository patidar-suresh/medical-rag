# Everything runs locally; no cloud API keys are needed.

# Local LLM served by Ollama
MEDRAG_OLLAMA_URL=http://localhost:11434
MEDRAG_LLM_MODEL=llama3.2:3b
MEDRAG_LLM_NUM_CTX=8192
MEDRAG_LLM_TEMPERATURE=0.1

# Vector database (Qdrant in Docker)
MEDRAG_QDRANT_URL=http://localhost:6333
MEDRAG_COLLECTION=medrag_pc160_800

# Local embedding model (downloaded once from Hugging Face, then cached)
MEDRAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
MEDRAG_EMBED_DEVICE=cuda
MEDRAG_EMBED_BATCH_SIZE=64

# Chunking (tokens of the embedding model) and retrieval: Phase 3 winner.
# Changing these needs a re-ingest, ideally into a new MEDRAG_COLLECTION.
MEDRAG_CLEAN_TEXT=true
MEDRAG_CHUNK_STRATEGY=structured
MEDRAG_CHUNK_SIZE=160
MEDRAG_CHUNK_OVERLAP=20
MEDRAG_PARENT_CHUNK_SIZE=800
MEDRAG_CONTEXTUAL_HEADERS=false
MEDRAG_TOP_K=5

# Retrieval: Phase 4 winner. Hybrid = dense + BM25 fused with RRF, then a cross-encoder
# reranks the top candidates. MEDRAG_RERANK_MODEL= (empty) turns reranking off.
MEDRAG_RETRIEVAL_MODE=hybrid
MEDRAG_RETRIEVAL_CANDIDATES=50
MEDRAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MEDRAG_EXPAND_ABBREVIATIONS=false
MEDRAG_MAX_PER_BOOK=0

MEDRAG_CORPUS_DIR=textbooks/en

# Uncomment after the first model download to guarantee fully offline runs
# HF_HUB_OFFLINE=1
